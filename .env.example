# ---- Dify 代理配置（复制为 .env 或填进托管平台的环境变量） ----

# 必填：Dify 应用的 API Key。只放在服务器，绝不写入前端。
# 获取：Dify → 应用 → 访问 API → API 密钥
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：自定义 Dify 端点，默认 https://api.dify.ai/v1/chat-messages
DIFY_ENDPOINT=https://api.dify.ai/v1/chat-messages

# 可选：允许调用代理的来源，默认 *。上线后建议收紧到自己的域名。
ALLOW_ORIGIN=*
